# Adresse publique de l’API : aucune clé JWT, SMTP ou secret OAuth dans le mobile.
# iOS Simulator sur ce Mac : http://localhost:3000
# Android Emulator : http://10.0.2.2:3000
# Téléphone physique : IP locale du Mac, même Wi-Fi, par exemple http://192.168.1.20:3000
# L’écran Serveur permet de modifier cette adresse sans reconstruire l’application.
EXPO_PUBLIC_API_URL=http://localhost:3000

# Même ID Web que GOOGLE_CLIENT_ID dans le backend (pas le client secret).
EXPO_PUBLIC_GOOGLE_WEB_CLIENT_ID=
# Client OAuth Google de type iOS pour le bundle com.sonora.musicroom.
# Le schéma d’URL inversé est calculé par app.config.ts. Reconstruire après modification.
EXPO_PUBLIC_GOOGLE_IOS_CLIENT_ID=