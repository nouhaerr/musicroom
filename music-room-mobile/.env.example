# Adresse publique de l’API : aucune clé JWT, SMTP ou secret OAuth dans le mobile.
# iOS Simulator sur ce Mac : http://localhost:3000
# Android Emulator : http://10.0.2.2:3000
# Téléphone physique : IP locale du Mac, même Wi-Fi, par exemple http://192.168.1.20:3000
# L’écran Serveur permet de modifier cette adresse sans reconstruire l’application.
EXPO_PUBLIC_API_URL=http://localhost:3000
