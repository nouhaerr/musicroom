# Serveur
PORT=3000

# Base de données (utilisée par Prisma)
# Postgres: used by docker-compose to create the DB, and by Prisma via DATABASE_URL
POSTGRES_USER=musicroom
POSTGRES_PASSWORD=changeme
POSTGRES_DB=musicroom
DATABASE_URL="postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}?schema=public"

# JWT : deux secrets aléatoires distincts obligatoires, au moins 32 octets chacun.
# Premier make : génération automatique uniquement si .env n'existe pas.
# .env existant : make secrets (invalide les anciens tokens après redémarrage).
JWT_ACCESS_SECRET=
JWT_ACCESS_EXPIRES_IN=15m
JWT_REFRESH_SECRET=
JWT_REFRESH_EXPIRES_IN=7d

# Email (validation de compte / mot de passe oublié)
# log = liens dans la console (développement uniquement) ; smtp = vrais emails.
MAIL_TRANSPORT=log
# MAIL_TRANSPORT=smtp
# Gmail : smtp.gmail.com, port 465, MAIL_SECURE=true.
# Sur le port 587 : MAIL_SECURE=false, STARTTLS obligatoire.
MAIL_HOST=
MAIL_PORT=587
MAIL_SECURE=false
MAIL_USER=
APP_URL=http://localhost:3000
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=true
# Gmail : mot de passe d'application, avec validation en deux étapes activée.
MAIL_PASSWORD=
MAIL_FROM=no-reply@music-room.local
# MAIL_USER=adresse-du-compte-sonora@gmail.com
# MAIL_PASSWORD=mot_de_passe_application
# MAIL_FROM="Sonora <adresse-du-compte-sonora@gmail.com>"


# OAuth Facebook (https://developers.facebook.com/apps)
FACEBOOK_CLIENT_ID=
FACEBOOK_CLIENT_SECRET=
FACEBOOK_CALLBACK_URL=http://localhost:3000/auth/facebook/callback

# OAuth Google (https://console.cloud.google.com/apis/credentials)
# Mettre false en local si vous n'avez pas encore de client Google.
# Avec true (valeur par défaut), GOOGLE_CLIENT_ID est obligatoire au démarrage.
# Client OAuth de type Application Web, identique au webClientId du SDK mobile.
# Les clients Android/iOS sont configurés séparément dans Google Cloud.
GOOGLE_AUTH_ENABLED=false
GOOGLE_CLIENT_ID=
# Pas de GOOGLE_CLIENT_SECRET ni de callback backend pour le flux ID token natif.
# Guide : docs/GOOGLE-LOGIN.md
